# .env
# Clé secrète pour sécuriser les sessions Flask.
FLASK_SECRET_KEY='une-longue-chaine-aleatoire-et-secrete-ici'

# --- CONFIGURATION LDAP (adaptée pour notre conteneur LDAP) ---
FLASK_LDAP_HOST='ldap_server' # On utilise le nom du service Docker
FLASK_LDAP_PORT=389
FLASK_LDAP_BASE_DN='dc=mondomaine,dc=com'
FLASK_LDAP_USER_DN='ou=users'
FLASK_LDAP_USER_RDN_ATTR='uid'
FLASK_LDAP_USER_LOGIN_ATTR='uid'
FLASK_LDAP_BIND_USER_DN=None
FLASK_LDAP_BIND_USER_PASSWORD=None






# --- RÔLE ADMIN ---
ADMIN_USERNAME='admin_ldap'



STORAGE_SERVER_IP='storage_server'