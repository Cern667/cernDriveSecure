# =========================================
# 🔐 FLASK CONFIGURATION
# =========================================
# Secret key for Flask sessions (CHANGE THIS!)
# Generate with: python3 generate_secret.py
SECRET_KEY=change-me-in-production-use-generate-secret-script

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# =========================================
# 📁 LDAP CONFIGURATION
# =========================================
LDAP_ORGANISATION="NAS Company"
LDAP_DOMAIN=nas.local
LDAP_BASE_DN=dc=nas,dc=local
LDAP_ADMIN_PASSWORD=admin

# =========================================
# 🚀 APPLICATION
# =========================================
# Port (default: 5000)
FLASK_PORT=5000
