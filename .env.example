## Exemple de configuration pour NAS (à commiter)
# Remplacez les valeurs sensibles en local dans votre .env (non commité)

# --- Flask ---
FLASK_PORT=8000
FLASK_SECRET_KEY=change-me-please

# --- Admin ---
ADMIN_USERNAME=admin

# --- LDAP ---
# Pour un usage simple en local, vous pouvez rester en mock
FLASK_USE_MOCK_LDAP=True
FLASK_LDAP_FALLBACK_TO_LDIF=True
FLASK_LDAP_HOST=ldap://127.0.0.1:389
FLASK_LDAP_BASE_DN=dc=mondomaine,dc=com
FLASK_LDAP_USER_DN=ou=users
FLASK_LDAP_USER_RDN_ATTR=uid
FLASK_LDAP_USER_SEARCH_FILTER=(uid={username})
FLASK_LDAP_USER_LOGIN_ATTR=uid
FLASK_LDAP_BIND_USER_DN=cn=admin,dc=mondomaine,dc=com
FLASK_LDAP_BIND_USER_PASSWORD=admin
FLASK_LDAP_USE_SSL=False
FLASK_LDAP_PORT=389

# --- Stockage ---
STORAGE_SERVER_IP=127.0.0.1
STORAGE_SERVER_PORT=65432

# --- Dossiers temporaires (client) ---
UPLOAD_FOLDER=temp_uploads
DOWNLOAD_FOLDER=temp_downloads