# =============================================================================
# Flask Configuration
# =============================================================================
# WARNING: Change all default values before production deployment
#
# Secret key for Flask sessions (REQUIRED)
# Auto-generated by start.sh if not set
# To generate manually: python3 scripts/generate_secret.py
SECRET_KEY=change-me-in-production-use-generate-secret-script

# Application admin user (has special privileges in the app)
# This is the LDAP username that will have admin rights
# The password is set in ldap_bootstrap/01-users.ldif (default: admin123)
ADMIN_USERNAME=admin

# DEPRECATED: Not used - password is managed in LDAP (01-users.ldif)
# Keep for backward compatibility with start.sh display
ADMIN_PASSWORD=admin123

# =============================================================================
# LDAP Configuration
# =============================================================================
# LDAP organization name
LDAP_ORGANISATION="NAS Company"

# LDAP domain (e.g., nas.local, example.com)
LDAP_DOMAIN=nas.local

# LDAP Base DN (must match LDAP_DOMAIN)
# Example: dc=nas,dc=local for nas.local
LDAP_BASE_DN=dc=nas,dc=local

# LDAP server admin password (CHANGE THIS)
# This is the password for cn=admin (LDAP superadmin, NOT app user)
# Used only for LDAP server administration and initial user import
LDAP_ADMIN_PASSWORD=admin

# =============================================================================
# Application
# =============================================================================
# Web interface port (default: 5000)
FLASK_PORT=5000

# =============================================================================
# Deployment Notes
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate SECRET_KEY: python3 scripts/generate_secret.py
# 3. Change passwords:
#    - LDAP_ADMIN_PASSWORD (LDAP server admin)
#    - Edit ldap_bootstrap/01-users.ldif to change user passwords (including admin user)
# 4. Update LDAP settings if needed (domain, organization)
# 5. Start with: docker-compose up -d
#
# OR use automated script: ./start.sh
# The script will create .env and generate SECRET_KEY automatically
#
# Default credentials after first start:
#   - Username: admin (or alice, bob, charlie)
#   - Password: admin123 (or alice123, bob123, charlie123)
#   - Change these in ldap_bootstrap/01-users.ldif before first start!
